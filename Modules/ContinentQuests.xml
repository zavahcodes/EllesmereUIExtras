<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- Quest icon on the continent maps (ContinentQuests.lua). OnLoad is
         called by the map when the pin is created (MapCanvasMixin:AcquirePin). -->
    <Frame name="ZavahTweaksContinentQuestPinTemplate" mixin="ZavahTweaksContinentQuestPinMixin" enableMouse="true" virtual="true">
        <Size x="22" y="22"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Badge" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Mark">
                    <Size x="13" y="13"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>
</Ui>
